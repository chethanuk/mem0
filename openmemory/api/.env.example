OPENAI_API_KEY=sk-xxx
USER=user

# LLM Configuration (optional - defaults to openai/gpt-4o-mini)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:latest
# LLM_API_KEY=
# LLM_BASE_URL=
# OLLAMA_BASE_URL=http://localhost:11434

# Embedder Configuration (optional - defaults to openai/text-embedding-3-small)
# EMBEDDER_PROVIDER=ollama
# EMBEDDER_MODEL=nomic-embed-text
# EMBEDDER_API_KEY=
# EMBEDDER_BASE_URL=

# LM Studio Configuration (optional - fully local, no OpenAI key needed)
# Set LLM_MODEL/EMBEDDER_MODEL to the model identifiers shown in LM Studio;
# both a chat model and an embedding model must be loaded.
# LLM_PROVIDER=lmstudio
# LLM_MODEL=
# EMBEDDER_PROVIDER=lmstudio
# EMBEDDER_MODEL=
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
